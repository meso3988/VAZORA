# VAZORA environment — copy to .env.local and fill in. NEVER commit real values.
# Names only. NEXT_PUBLIC_* values are embedded in the browser bundle; every
# other variable is SERVER-ONLY and must never be exposed to the client.

# --- Supabase (public: browser-safe; RLS enforces isolation) ------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer publishable key name, read where present.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server-only) ------------------------------------------------------
# Service role key. Bypasses RLS — trusted server code only. Required for
# scheduled Officer sweeps (POST /api/officer/sweep), which run without a session.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data provider (server-only) -------------------------------------------------
# "mock"     → in-memory demo fixtures (Phase 1 demo experience, anonymous demo)
# "supabase" → real tenant data (requires the Supabase variables above)
VAZORA_DATA_PROVIDER=mock

# --- Model access (server-only) --------------------------------------------------
# Shared key/base URL for the OpenAI-compatible adapters below.
VAZORA_AI_API_KEY=
VAZORA_AI_BASE_URL=
# Vendor-specific keys, only if those adapters are selected.
VAZORA_ANTHROPIC_API_KEY=
VAZORA_ANTHROPIC_MODEL=
VAZORA_GEMINI_API_KEY=
VAZORA_GEMINI_MODEL=
# Legacy demo assistant adapter (defaults to "mock").
VAZORA_AI_PROVIDER=

# --- Contract extraction (server-only) --------------------------------------------
# Unset provider = extraction unavailable (no silent fallback).
VAZORA_EXTRACTION_PROVIDER=
VAZORA_EXTRACTION_MODEL=
VAZORA_EXTRACTION_TEMPERATURE=
# Hard output ceiling per extraction request (sent as max_completion_tokens;
# includes reasoning tokens on reasoning models). Unset = provider default.
VAZORA_EXTRACTION_MAX_OUTPUT_TOKENS=

# --- Evidence verification (server-only) -------------------------------------------
VAZORA_VERIFICATION_PROVIDER=
VAZORA_VERIFICATION_MODEL=
VAZORA_VERIFICATION_TEMPERATURE=
# "0" disables automatic verification after upload.
VAZORA_EVIDENCE_AUTO_VERIFY=

# --- Contract Officer (server-only) -------------------------------------------------
# Unset provider = the Officer says it is unavailable (no fabricated answers).
VAZORA_OFFICER_PROVIDER=
VAZORA_OFFICER_MODEL=
VAZORA_OFFICER_REASONING_EFFORT=
VAZORA_OFFICER_TIMEOUT_MS=
VAZORA_OFFICER_MAX_RETRIES=

# --- Scheduled monitoring (server-only) ---------------------------------------------
# Shared secret for POST /api/officer/sweep (header x-vazora-sweep-secret).
# Unset = the endpoint is disabled (404). Also requires SUPABASE_SERVICE_ROLE_KEY
# and an external scheduler calling the endpoint.
VAZORA_SWEEP_SECRET=
# Vercel Cron adapter GET /api/officer/sweep/scheduled. Vercel sends
# "Authorization: Bearer <CRON_SECRET>". Unset = the adapter is disabled (404).
CRON_SECRET=
# JSON list of the organizations to sweep and the member account each run is
# attributed to: [{"organizationId":"<uuid>","actorUserId":"<uuid>"}].
# Missing or malformed = 503 (never "all organizations").
VAZORA_SCHEDULED_SWEEPS=
