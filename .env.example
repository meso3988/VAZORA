# VAZORA environment — copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (Phase 2A) -----------------------------------------------------
# Project URL and anon key (safe for browser; RLS enforces isolation).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Bypasses RLS — use only in trusted server code
# (e.g. admin demo-lead tooling). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Data provider ------------------------------------------------------------
# "mock"     → in-memory demo fixtures (Phase 1 demo experience, anonymous demo)
# "supabase" → real tenant data (requires the three Supabase variables above)
VAZORA_DATA_PROVIDER=mock
